# Скопируйте в video/.env и заполните. Файл .env в git не попадает.
# Только тестовые аккаунты — никаких реальных данных клиентов.
PETGO_BASE_URL=https://pet.oscarclinic.kz
PETGO_HOME_PATH=/

# Кабинет владельца питомца
PETGO_OWNER_LOGIN_URL=/
PETGO_OWNER_LOGIN=
PETGO_OWNER_PASSWORD=
PETGO_OWNER_REQUEST_URL=
PETGO_OWNER_CHAT_URL=

# Платформа сотрудников
PETGO_STAFF_LOGIN_URL=/
PETGO_STAFF_LOGIN=
PETGO_STAFF_PASSWORD=
PETGO_STAFF_EMPLOYEES_URL=
PETGO_STAFF_REQUESTS_URL=

# 0 — заполнять формы, но не отправлять (не создавать заявки/сотрудников на сайте)
PETGO_SUBMIT=1
